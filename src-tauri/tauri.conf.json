{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apixa",
  "version": "0.1.0",
  "identifier": "com.belal.apixa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Apixa",
        "width": 420,
        "height": 320,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "url": "/splash.html"
      },
      {
        "label": "main",
        "title": "Apixa",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/code.png",
      "icons/code.png",
      "icons/code.png",
      "icons/code.png",
      "icons/code.png"
    ],
    "resources": []
  }
}